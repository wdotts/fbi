# Nothing below is required to get started - MusicBrainz works with no
# credentials at all. Fill in only the sections for sources you want to use.

# --- MusicBrainz (recommended default source; free, no approval needed) ---
# MusicBrainz asks automated clients to identify themselves with a contact
# email in the User-Agent header. Not strictly required, but recommended.
APP_CONTACT_EMAIL=

# --- Discogs (optional; free, no approval needed) ---
# A personal access token raises Discogs' rate limit from ~25 to ~60
# requests/minute. Get one at https://www.discogs.com/settings/developers
# Not required to use Discogs at all, just to go faster.
DISCOGS_TOKEN=

# --- Amazon (optional; only needed for the 'amazon' source and to build
# real "Add to Cart" links for items that don't already carry a known ASIN)
# ---
# Amazon Creators API credentials (the successor to the Product Advertising
# API 5.0). You must be an approved Amazon Associate with API access to get
# these — see README.md for details on how to request them.
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=

# Your Amazon Associates tracking/partner tag, e.g. yourtag-20. Used for
# real Amazon cart links even without the credentials above.
AMAZON_PARTNER_TAG=

# Two-letter Amazon marketplace to search/link to (US, UK, DE, FR, JP, CA, ...)
AMAZON_COUNTRY=US

# Amazon Creators API version to target (only used if credentials above are set).
AMAZON_API_VERSION=2.2
