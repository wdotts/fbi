# Amazon Creators API credentials (the successor to the Product Advertising
# API 5.0). You must be an approved Amazon Associate with API access to get
# these — see README.md for details on how to request them.
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=

# Your Amazon Associates tracking/partner tag, e.g. yourtag-20
AMAZON_PARTNER_TAG=

# Two-letter Amazon marketplace to search (US, UK, DE, FR, JP, CA, ...)
AMAZON_COUNTRY=US

# Amazon Creators API version to target.
AMAZON_API_VERSION=2.2
